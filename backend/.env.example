# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3007
NODE_ENV=development
# Public origin used to build absolute URLs in the delivery payload.
# Empty → relative URLs. Set this to the public hostname in production.
PUBLIC_BASE_URL=

# ─── x402 / X Layer (SELLER side — merchant credentials) ─────────────────────
# off | demo | on. With "off" every endpoint is free — local development only.
X402_MODE=off
# Merchant address that receives settlement. Empty disables the gate entirely.
X402_PAY_TO=
XLAYER_API_KEY=
XLAYER_SECRET_KEY=
XLAYER_PASSPHRASE=

PRICE_ANIMATED_USD=0.40

# ─── AI (VideoSpec copy + vision palette refine) ─────────────────────────────
# OpenAI-compatible endpoint. Without a key the deterministic fallback runs, so
# a video is still produced — just with generic copy and an extraction-only palette.
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=gpt-4o-mini
SUMOPOD_VISION_MODEL=

# ─── Voiceover (ElevenLabs) ──────────────────────────────────────────────────
# Keys are tried in order; the second takes over when the first runs out of
# credit, which otherwise takes the whole deployment silent without erroring.
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
# Optional. Empty picks an English narration voice from the account. Premade
# voice ids are shared across accounts but ElevenLabs retires its current
# defaults after 2026-12-31, so pinning one is a scheduled outage.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_ENABLED=true

# Tempo used only when no licensed track is available and the bed is
# synthesized. A track from MUSIC_DIR carries its own tempo and overrides this.
BPM=112
# Licensed backing tracks named "<style>-<bpm>[-label].mp3" — see
# assets/music/README.md. Missing or empty falls back to synthesis.
MUSIC_DIR=

# ─── onchainos CLI (agent metadata lookup) ───────────────────────────────────
# Absolute path — a spawned process does not inherit the interactive PATH.
ONCHAINOS_BIN=

# ─── Render worker ───────────────────────────────────────────────────────────
VIDEO_PROJECT_DIR=../video
OUTPUT_DIR=/tmp/pitch-my-agent
OUTPUT_TTL_MS=604800000
RENDER_TIMEOUT_MS=1800000
# Quoted to callers. Measure it on the host that will actually render: a laptop
# does ~2 min, a small VPS ~7 min, and quoting the laptop makes buyers think the
# job has hung.
RENDER_ETA_SECONDS=420
# Concurrent renders, and Chromium tabs per render. Both are 1 on a small box —
# Remotion's own default assumes a workstation and gets OOM-killed mid-frame.
RENDER_CONCURRENCY=1
REMOTION_CONCURRENCY=
# Delete other jobs' output on each render. Local iteration only; in production
# this destroys deliveries buyers have paid for.
PRUNE_PREVIOUS_RENDERS=false
