# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3007
NODE_ENV=development
# Public origin used to build absolute URLs in the delivery payload.
# Empty → relative URLs. Set this to the Cloudflare Tunnel hostname in prod.
PUBLIC_BASE_URL=

# ─── x402 / X Layer (SELLER side — merchant credentials) ─────────────────────
# These are OKX API credentials used by the facilitator to settle incoming
# payments. Completely separate from the buyer-side agentic-wallet session.
X402_MODE=off
X402_PAY_TO=
XLAYER_API_KEY=
XLAYER_SECRET_KEY=
XLAYER_PASSPHRASE=

# Per-tier price in USD (USDT0 on X Layer).
PRICE_STANDARD_USD=2.00
PRICE_PREMIUM_USD=4.00

# ─── AI (VideoSpec copy + vision palette refine) ─────────────────────────────
# OpenAI-compatible endpoint. Without a key the deterministic fallback is used,
# so the service still produces a video (just less tailored copy/colors).
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=deepseek-v4-flash
SUMOPOD_VISION_MODEL=

# ─── Voiceover (ElevenLabs) ──────────────────────────────────────────────────
# The narration script is written by the AI above (Sumopod); this only turns that
# script into audio. Without a key the video renders silent.
ELEVENLABS_API_KEY=
# Optional. Leave empty and a voice is picked from your account automatically,
# preferring an English narration voice. Premade voice ids are public and shared
# across accounts, but ElevenLabs retires its current default voices after
# 2026-12-31 — so pinning one here is a scheduled outage. Set it only to force a
# specific voice you have chosen deliberately.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Tempo of the generated backing track. Scene cuts are quantized to bars at this
# tempo, so timing is authored rather than arbitrary (docs/VIDEO_CRAFT.md).
BPM=112

# ─── onchainos CLI (agent metadata lookup) ───────────────────────────────────
# Absolute path — a spawned process does not inherit the interactive PATH.
ONCHAINOS_BIN=/Users/youvandra/.local/bin/onchainos

# ─── Remotion render worker ──────────────────────────────────────────────────
# Directory holding the Remotion template project (props-driven).
VIDEO_PROJECT_DIR=../video
# Where rendered videos are written and served from.
OUTPUT_DIR=/tmp/pitch-my-agent
# Delivered files older than this are cleaned up (default 7 days).
OUTPUT_TTL_MS=604800000
# Hard cap on a single render before it is abandoned (default 15 min).
RENDER_TIMEOUT_MS=900000
# Max concurrent renders. Chromium is heavy — keep this small.
RENDER_CONCURRENCY=1
